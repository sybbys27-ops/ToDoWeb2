# Existing Gemini API
GEMINI_API_KEY=

# GitHub token with permission to create/read/update Gists
GITHUB_GIST_TOKEN=

# App-only sync key. Use the same value in Vercel and when the browser asks for the sync key.
TODO_GIST_SYNC_KEY=

# Optional. Leave blank to let the app find/create the ToDoWeb2 Gist automatically.
TODO_GIST_ID=
